# Reference: https://shlink.io/documentation/environment-variables

# + -------------------------------------------------------------------------- +
# | GENERAL                                                                    |
# + -------------------------------------------------------------------------- +

# The default short domain used for this Shlink instance.
# Example: s.test
DEFAULT_DOMAIN=

# Tells if Shlink is served with https or not (true or false).
# It's still up to you to actually serve it with HTTPS.
IS_HTTPS_ENABLED=

# The license key used to download new GeoLite2 database files.
# Go to GeoLite2 license key to know how to generate it.
# Not providing a license key will completely disable visits geolocation.
GEOLITE_LICENSE_KEY=

# The base path from which you plan to serve Shlink, in case you don't want
# to serve it from the root of the domain.
# It has to start with a forward-slash, like /shlink.
# Default: ''
BASE_PATH=''

# A timezone code as defined in this list.
# All dates stored by Shlink (visits, short URL creation, etc) will be
# considered to be in this timezone.
# Default: the default timezone set in PHP config will be used,
# which is UTC in the case of the docker image.
TIMEZONE=

# A prefix used for all cache keys generated by Shlink.
# It's important to set a unique value here if you have multiple Shlink
# instances sharing the same cache store (same server when not using redis,
# or same redis cluster), otherwise there could be collisions.
# Default: Shlink
CACHE_NAMESPACE=Shlink

# Either the amount of proxies in front of Shlink, or a comma-separated list
# of their IP addresses as fixed address (100.200.80.40),
# CIDR block (192.168.10.0/24) or wildcard pattern (11.22.*.*).
# It's important to set this if you have more than one reverse proxy in front
# of Shlink, so that the visitor's IP addresses can be properly determined.
TRUSTED_PROXIES=

# The maximum amount of memory that every Shlink process can use.
# You can provide a number, which will be the amount of memory in bytes, or a
# number followed by K for kilobytes, M for megabytes or G for gigabytes.
# You can also provide -1 to set no memory limit.
# Default: 512M
MEMORY_LIMIT=512M

# The format in which Shlink generates logs.
# It can be console (the default) or json.
LOGS_FORMAT=console

# + -------------------------------------------------------------------------- +
# | URL SHORTENING                                                             |
# + -------------------------------------------------------------------------- +

# The length you want generated short codes to have.
# Has to be at least 4, so any value smaller than that will fall back to 4.
# Default: 5.
DEFAULT_SHORT_CODES_LENGTH=5

# The amount of visits on short URLs which will not allow them to be deleted.
# If not provided, this restriction will be disabled.
DELETE_SHORT_URL_THRESHOLD=

# Used to automatically resolve the short URL's title based on the <title />
# tag in the long URL.
# Default: true
AUTO_RESOLVE_TITLES=true

# Allows to create and handle multi-segment custom slugs when true is provided.
# See multi-segment custom slugs for more information.
# Default: false
MULTI_SEGMENT_SLUGS_ENABLED=false

# Allows to enable support for trailing slashes in
# short URLs when true is provided. See short URLs
# trailing slash for more information.
# Default: false
SHORT_URL_TRAILING_SLASH=false

# strict or loose.
# Determines how to match short URLs. See short URLs mode for more information.
# Default: strict
SHORT_URL_MODE=strict

# + -------------------------------------------------------------------------- +
# | DATABASE                                                                   |
# + -------------------------------------------------------------------------- +

# ! -------------------------------------------------------------------------- !
# !                                ! WARNING !                                 !
# ! -------------------------------------------------------------------------- !
# ! SQLITE IS INTENDED FOR TESTING/AUTOMATION PURPOSES ONLY.                   !
# ! USING IT IN PRODUCTION IS NOT SUPPORTED, EVEN LESS IF MOUNTED VIA          !
# ! DOCKER VOLUMES. THERE'S A POTENTIAL RISK OF BREAKAGE WHEN UPDATING SHLINK, !
# ! SO MAKE SURE YOU MOVE TO ANY OF THE OTHER ALTERNATIVES IF YOU PLAN TO USE  !
# ! SHLINK LONG TERM.                                                          !
# ! -------------------------------------------------------------------------- !

# mysql, maria, postgres, mssql or sqlite.
DB_DRIVER=

# The database name to be used when using an external database driver
# Default: shlink
DB_NAME=shlink

# The host name of the database server when using an external database driver
DB_HOST=

# The port in which the database service is running when using an external
# database driver.
# Default: value is based on the value provided for DB_DRIVER
#  mysql or maria -> 3306
#  postgres       -> 5432
#  mssql          -> 1433
DB_PORT=

# The username credential to be used when using an external database driver
DB_USER=

# The password credential to be used when using an external database driver
DB_PASSWORD=

# Alternatively to the DB_HOST, you can provide this to connect through
# unix sockets when using mysql, maria or postgres drivers.
DB_UNIX_SOCKET=

# Whether it is desired to use an encrypted connection with the database or not.
# Default: false
DB_USE_ENCRYPTION=false

# + -------------------------------------------------------------------------- +
# | REDIRECTS                                                                  |
# + -------------------------------------------------------------------------- +

# 301, 302, 308 or 307 (last two since v3.5.0).
# Determines the status code that should be used on redirects from short
# to long URLs. Setting 308 or 307 implicitly makes requests to short URLs work
# regardless the HTTP method.
# Default: 302
REDIRECT_STATUS_CODE=302

# Allows to set the amount of seconds that redirects should be cached when
# redirect status is 301 or 308.
# Default: 30
REDIRECT_CACHE_LIFETIME=30

# If a URL is provided here, when a user tries to access an invalid short URL,
# and the visited domain does not have a redirect URL of its own, he/she will be
# redirected to this value. If this env var is not provided, the user will see
# a generic 404 - not found page.
DEFAULT_INVALID_SHORT_URL_REDIRECT=

# If a URL is provided here, when a user tries to access a URL not matching
# any supported by the router, and the visited domain does not have a redirect URL
# of its own, he/she will be redirected to this value.
# If var is not provided, the user will see a generic 404 - not found page
DEFAULT_REGULAR_404_REDIRECT=

# If a URL is provided here, when a user tries to access Shlink's base URL,
# and the visited domain does not have a redirect URL of its own, he/she will be
# redirected to this value.
# If var is not provided, the user will see a generic 404 - not found page
DEFAULT_BASE_URL_REDIRECT=

# Determines how Shlink should match short URLs when they start with a known
# short code. (See Extra path forwarding for more info).
#  default -> Only exact short URLs will match.
#             Extra paths will result in a not-found short URL.
#  append  -> The rest of the path will be appended to the long URL
#             before redirection.
#  ignore  -> The rest of the path will be ignored.
REDIRECT_EXTRA_PATH_MODE=default

# This is deprecated since Shlink 4.4.0.
# Use REDIRECT_EXTRA_PATH_MODE=append instead.
REDIRECT_APPEND_EXTRA_PATH=

# + -------------------------------------------------------------------------- +
# | TRACKING                                                                   |
# + -------------------------------------------------------------------------- +

# Tells if visit tracking should be completely disabled.
# (see Tracking visits for more info)
# Default: false
DISABLE_TRACKING=false

# Tells if orphan visits should be tracked or not.
# (see Tracking visits for more info).
# Default: true
TRACK_ORPHAN_VISITS=true

# The name of a query param that can be used to visit short URLs avoiding the
# visit to be tracked. This feature won't be available if no value is provided
# (see Tracking visits for more info).
DISABLE_TRACK_PARAM=

# A comma-separated list of IP address patterns from which all tracking should
# be disabled. It allows providing fixed IP addresses (100.200.80.40),
# CIDR blocks (192.168.10.0/24) or wildcard patterns (11.22.*.*)
DISABLE_TRACKING_FROM=

# Tells if tracking of the IP address (and therefore visitors location) should
# be disabled. (see Tracking visits for more info).
# Default: false
DISABLE_IP_TRACKING=false

# Tells if tracking of the referrer should be disabled.
# See Tracking visits for more info.
# Default: false
DISABLE_REFERRER_TRACKING=false

# Tells if tracking of the user agent should be disabled.
# See Tracking visits for more info.
# Default: false
DISABLE_UA_TRACKING=false

# ! -------------------------------------------------------------------------- !
# !                                ! WARNING !                                 !
# ! -------------------------------------------------------------------------- !
# ! Setting this to false will make your Shlink instance no longer be in       !
# ! compliance with the GDPR and other similar data protection regulations.    !
# ! -------------------------------------------------------------------------- !

# Tells if IP addresses from visitors should be obfuscated before storing them
# in the database. (see Tracking visits for more info).
# Default: true
ANONYMIZE_REMOTE_ADDR=true

# + -------------------------------------------------------------------------- +
# | ROBOTS.TXT                                                                 |
# + -------------------------------------------------------------------------- +

# Whether all short URLs should be allowed via robots.txt or not.
# If true, the crawlable option set in individual short URLs will be ignored.
# Default: false
ROBOTS_ALLOW_ALL_SHORT_URLS=false

# A comma-separated list of allowed user agents via robots.txt.
# Default: *
ROBOTS_USER_AGENTS=*

# + -------------------------------------------------------------------------- +
# | CROSS-ORIGIN                                                               |
# + -------------------------------------------------------------------------- +

# Determines for what origins Shlink will allow cross-domain requests.
# Possible values are:
#   - *: Access-Control-Allow-Origin header is set to *,
#        implicitly allowing all origins. This is the default value.
#   - <origin>: Access-Control-Allow-Origin header is explicitly set to the
#        value in the request's Origin header, allowing all origins,
#        but browsers will apply fewer restrictions than with *.
#   - A comma-separated list of origins: Access-Control-Allow-Origin header
#     is explicitly set to the value in the request's Origin header, but
#     only if it is one of the provided values. Otherwise,
#     Access-Control-Allow-Origin won't be set at all, restricting requests
#     from any other origin.
CORS_ALLOW_ORIGIN=*

# If true, the response will include Access-Control-Allow-Credentials: true,
# and the header won't be included at all otherwise.
# Default: false
CORS_ALLOW_CREDENTIALS=false

# Determines the value in Access-Control-Max-Age header.
# Default: 3600
CORS_MAX_AGE=3600

# + -------------------------------------------------------------------------- +
# | REAL-TIME UPDATES                                                          |
# + -------------------------------------------------------------------------- +

# A comma-separated list of the topics to which real-time updates should
# be sent, if at least one real-time updates integration is enabled.
# All topics are enabled if not provided.
# Possible values are:
#  - NEW_VISIT (notify when any short URL is visited, in a common topic)
#  - NEW_ORPHAN_VISIT (Notify when a new non-orphan)
#  - NEW_SHORT_URL_VISIT (Notify when a short URL is visited,
#                         on its own scoped topic.)
#  - NEW_SHORT_URL (Notify when a short URL is created)
REAL_TIME_UPDATES_TOPICS=

# + -------------------------------------------------------------------------- +
# | REDIS                                                                      |
# + -------------------------------------------------------------------------- +

# A comma-separated list of redis servers which Shlink uses for shared locks,
# cache, and optionally real-time updates through pub/sub.
# Make sure to include the port number and credentials for every server.
REDIS_SERVERS=

# The name of the sentinel service if you want to use redis sentinel.
# If this value is provided, the servers provided in REDIS_SERVERS will be
# considered sentinel instances.
REDIS_SENTINEL_SERVICE=

# The user credential for redis server/s.
# Ignored when not using REDIS_SENTINEL_SERVICE
REDIS_SERVERS_USER=

# The password credential for redis server/s.
# Ignored when not using REDIS_SENTINEL_SERVICE
REDIS_SERVERS_PASSWORD=

# Tells if the configured redis instance/cluster should also be used to
# publish real-time updates via redis pub/sub.
# Default: false
REDIS_PUB_SUB_ENABLED=false

# + -------------------------------------------------------------------------- +
# | MERCURE HUB                                                                |
# + -------------------------------------------------------------------------- +

# Whether mercure integration for real-time updates is enabled or not.
# Before Shlink 4.5, mercure integration was implicitly enabled just by
# providing a value for MERCURE_PUBLIC_HUB_URL.
# Default: false
MERCURE_ENABLED=false

# The public URL of a mercure hub server to which Shlink will send updates.
# This URL will also be served to consumers that want to subscribe to those
# updates.
MERCURE_PUBLIC_HUB_URL=

# An internal URL for a mercure hub. Will be used only when publishing updates
# to mercure, and does not need to be public. If this is not provided
# but MERCURE_PUBLIC_HUB_URL was, the former will be used to publish updates.
MERCURE_INTERNAL_HUB_URL=

# The secret key that was provided to the mercure hub server, in order to be
# able to generate valid JWTs for publishing/subscribing to that server.
MERCURE_JWT_SECRET=

# + -------------------------------------------------------------------------- +
# | RabbitMQ                                                                   |
# + -------------------------------------------------------------------------- +

# Tells if the integration with a RabbitMQ server for real-time updates
# should be enabled.
# Default: false
RABBITMQ_ENABLED=false

# The RabbitMQ server host name.
# This will be ignored if RABBITMQ_ENABLEDis false
RABBITMQ_HOST=

# Whether connection is encrypted with SSL/TLS or not.
# This will be ignored if RABBITMQ_ENABLED is false
# Default: false
RABBITMQ_USE_SSL=false

# The RabbitMQ server port.
# This will be ignored if RABBITMQ_ENABLED is false
# Default: 5672
RABBITMQ_PORT=5672

# The RabbitMQ server username credential.
# This will be ignored if RABBITMQ_ENABLED is false
RABBITMQ_USER=

# The RabbitMQ server password credential.
# This will be ignored if RABBITMQ_ENABLED is false
RABBITMQ_PASSWORD=

# The RabbitMQ server VHost.
# This will be ignored if RABBITMQ_ENABLED is false
# Default: /
RABBITMQ_VHOST=/

# + -------------------------------------------------------------------------- +
# | MATOMO                                                                     |
# + -------------------------------------------------------------------------- +

# Tells if visits should be sent to a Matomo instance.
# Default: false
MATOMO_ENABLED=false

# External Matomo server URL.
# Ignored if MATOMO_ENABLED is false.
MATOMO_BASE_URL=

# Site ID to be used for Shlink visits.
# Ignored if MATOMO_ENABLED is false.
MATOMO_SITE_ID=

# API token so that Shlink can call Matomo's API.
# Ignored if MATOMO_ENABLED is false.
MATOMO_API_TOKEN=

# + -------------------------------------------------------------------------- +
# |                      Specific for the docker image                         |
# | These are the env vars that only the docker image take into consideration  |
# + -------------------------------------------------------------------------- +

# Can be used to set the port in which Shlink listens.
# Some cloud providers, like Google cloud or Heroku, expect to be able to
# customize exposed port by providing this env var.
# Default: 8080
PORT=8080

# The amount of concurrent http requests this Shlink instance will be able to serve.
# Default: the amount of available CPUs
WEB_WORKER_NUM=

# The amount of concurrent background tasks this Shlink instance will be able
# to execute.
# Default: the amount of available CPUs
TASK_WORKER_NUM=

# If provided with value true, it will skip the initial GeoLite2 db file
# download, speeding-up the container start-up. As a side effect, first visits
# on this container will remain un-located until the file finishes
# downloading in background.
SKIP_INITIAL_GEOLITE_DOWNLOAD=

# An API key that will be created once during container start-up,
# with admin permissions. Considerations with the initial API key:
#  - It will be ignored if other API keys already exist.
#  - If the env var is removed at some point, that won't make the API key
#    to be deleted.
#  - If the value is changed at some point, that won't make the API key
#    to be edited.
# Between v3.3.0 and v3.6.3 it was possible to pass this env var to any
# non-docker Shlink instance, but that caused problems. Now only the docker
# image takes it into consideration.
# Use the installation tool for non-docker installations.
INITIAL_API_KEY=

# + -------------------------------------------------------------------------- +
# | QR CODES                                                                   |
# + -------------------------------------------------------------------------- +

# ! -------------------------------------------------------------------------- !
# !                                ! WARNING !                                 !
# ! -------------------------------------------------------------------------- !
# ! Starting with Shlink 4.5.0, generating QR codes through Shlink is          !
# ! considered deprecated. See this issue for details:                         !
# !                                                                            !
# ! https://github.com/shlinkio/shlink/issues/2408                             !
# ! -------------------------------------------------------------------------- !

# A value between 50 and 1000 to determine the default size of generated QR
# codes when the size query param is not provided.
# Default: 300
DEFAULT_QR_CODE_SIZE=300

# A value greater than 0 to determine the default margin of generated QR
# codes when the margin query param is not provided.
# Default: 0
DEFAULT_QR_CODE_MARGIN=0

# One of png or svg, to determine the default format of generated QR codes
# when the format query param is not provided.
# Default: png
DEFAULT_QR_CODE_FORMAT=png

# One of L (Low), M (Medium), Q (Quartile) or H (High), to determine the
# default error correction of generated QR codes when the errorCorrection query
# param is not provided.
# Default: l
DEFAULT_QR_CODE_ERROR_CORRECTION=l

# Tells if the block size should be round on QR codes, making it more readable,
# but potentially adding some extra margin as a side effect.
# Default: true
DEFAULT_QR_CODE_ROUND_BLOCK_SIZE=true

# Whether generating QR codes should work for disabled short URLs.
# Disabled short URLs are those which reached the maximum amount of visits,
# have a validSince date in the future, or a validUntil date in the past.
# Default: true
QR_CODE_FOR_DISABLED_SHORT_URLS=true

# The QR code foreground color.
# Default: #000000 (black)
DEFAULT_QR_CODE_COLOR=#000000

# The QR code background color.
# Default: #FFFFFF (white)
DEFAULT_QR_CODE_BG_COLOR=#FFFFFF

# A URL pointing to a logo that will be placed in the middle of the QR code.
# This one is experimental, as some images might break the QR code.
DEFAULT_QR_CODE_LOGO_URL=
